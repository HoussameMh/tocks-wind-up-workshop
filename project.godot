; Engine configuration file.
; Renderer is GL Compatibility because the development PC has Intel HD 520
; graphics. Input actions are registered in code by src/core/input_setup.gd.

config_version=5

[application]

config/name="Tock's Wind-Up Workshop"
run/main_scene="res://src/core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60

[display]

; Vsync is off and FPS is capped instead: on the development PC vsync lowered
; gameplay from about 90 FPS to about 24 (measured with tools/measure_fps.gd).
window/vsync/vsync_mode=0
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=1
lights_and_shadows/directional_shadow/size=2048
